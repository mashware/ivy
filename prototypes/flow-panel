#!/usr/bin/env python3
"""Live status panel for flow's works.

Reads .claude/work/<work>/meta.json and repaints when something changes.
It needs no hooks and no change to flow: flow's commands already write
meta.json at every step, and this panel only watches the disk.

Two modes:

  flow-panel [path]            lists every open work in the repo
  flow-panel --focus [path]    only the work of the current branch, in detail

The --focus mode is meant to live as a split of the pane where an agent
runs: it detects the branch of the directory it is opened in and shows
that task and that task only. Since flow creates one worktree per work,
each agent ends up in a different directory and each split tunes itself.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata

# Twilight palette, the same as the terminal's
DIM = "\033[38;2;95;90;96m"
FG = "\033[38;2;167;167;167m"
ORANGE = "\033[38;2;207;106;76m"
GREEN = "\033[38;2;143;157;106m"
YELLOW = "\033[38;2;249;238;152m"
BLUE = "\033[38;2;117;135;166m"
PURPLE = "\033[38;2;155;133;157m"
BOLD = "\033[1m"
RESET = "\033[0m"
CLEAR = "\033[H\033[2J\033[3J"

# Phase sequence per work type, following flow's commands
PHASES = {
    "feat": ["context", "brainstorm", "design", "plan", "build",
             "validate", "review", "ship"],
    "bug": ["context", "diagnose", "investigate", "fix",
            "validate", "review", "ship", "postmortem"],
}

TERMINAL_PHASES = {"done", "abandoned"}


# ─── text utilities ───────────────────────────────────────────────────────

def vis(text):
    """Visual width: wide symbols take two cells."""
    n = 0
    for ch in text:
        if unicodedata.combining(ch):
            continue
        n += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return n


def cut(text, width):
    text = " ".join(str(text).split())
    if vis(text) <= width:
        return text
    out, n = "", 0
    for ch in text:
        step = vis(ch)
        if n + step > width - 1:
            break
        out, n = out + ch, n + step
    return out + "…"


def wrap(text, width, max_lines):
    """Splits the text by words. The last line is truncated if it does not fit."""
    words = " ".join(str(text).split()).split(" ")
    lines, cur = [], ""
    for word in words:
        candidate = f"{cur} {word}".strip()
        if vis(candidate) <= width:
            cur = candidate
            continue
        if cur:
            lines.append(cur)
        if len(lines) == max_lines:
            # no room left: what remains is squeezed into the last line
            rest = " ".join(words[words.index(word):]) if word in words else word
            lines[-1] = cut(f"{lines[-1]} {rest}", width)
            return lines
        cur = word if vis(word) <= width else cut(word, width)
    if cur:
        lines.append(cur)
    return lines[:max_lines] or [""]


def ago(iso):
    """'2 h ago' from an ISO8601 date."""
    if not iso:
        return ""
    try:
        from datetime import datetime, timezone
        then = datetime.fromisoformat(iso)
        if then.tzinfo is None:
            then = then.replace(tzinfo=timezone.utc)
        secs = (datetime.now(timezone.utc) - then).total_seconds()
    except ValueError:
        return ""
    if secs < 90:
        return "now"
    if secs < 5400:
        return f"{int(secs // 60)} min ago"
    if secs < 172800:
        return f"{int(secs // 3600)} h ago"
    return f"{int(secs // 86400)} d ago"


# ─── locating the repo and the work ───────────────────────────────────────

def git(cwd, *args):
    try:
        out = subprocess.run(("git", "-C", cwd) + args, capture_output=True,
                             text=True, timeout=3)
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def find_repo(start):
    """The repo's main checkout.

    From a worktree we have to go back to the main one: .claude/work is
    ignored by git, so it only exists there.
    """
    start = os.path.abspath(start)
    common = git(start, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common:
        return os.path.dirname(common)

    # no git: walk up looking for .claude/work
    path = start
    while True:
        if os.path.isdir(os.path.join(path, ".claude", "work")):
            return path
        parent = os.path.dirname(path)
        if parent == path:
            return start
        path = parent


def current_branch(start):
    return git(os.path.abspath(start), "branch", "--show-current")


def work_dirs(repo):
    """Active work folders, ignoring the archive."""
    base = os.path.join(repo, ".claude", "work")
    if not os.path.isdir(base):
        return []
    out = []
    for name in sorted(os.listdir(base)):
        if name.startswith("_"):
            continue
        path = os.path.join(base, name)
        if os.path.isfile(os.path.join(path, "meta.json")):
            out.append(path)
    return out


def read_meta(path):
    try:
        with open(os.path.join(path, "meta.json"), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None


def pick_work(repo, branch, wanted=None):
    """Which work to show in focus mode, in order of reliability.

    1. The one asked for explicitly (--work or FLOW_WORK). It is the normal
       case when working from the main checkout, where every panel shares
       the directory and nothing tells them apart.
    2. The one of the current branch, if it matches. It works when each
       agent lives in its own worktree.
    3. The most recently touched one, as a last resort.
    """
    wanted = (wanted or os.environ.get("FLOW_WORK", "")).strip()
    found = []
    for path in work_dirs(repo):
        meta = read_meta(path)
        if meta:
            found.append((path, meta))

    if wanted:
        for path, meta in found:
            if wanted in (meta.get("ticket"), meta.get("slug")):
                return path, meta
        return None, None          # a specific one was asked for and it does not exist

    if branch:
        for path, meta in found:
            if meta.get("branch") == branch:
                return path, meta

    active = [(p, m) for p, m in found
              if m.get("phase") not in TERMINAL_PHASES]
    if active:
        return max(active, key=lambda pm: pm[1].get("updated_at", ""))
    return None, None


def list_json(repo):
    """The open works, for the WezTerm picker to offer."""
    out = []
    for path in work_dirs(repo):
        meta = read_meta(path)
        if not meta or meta.get("phase") in TERMINAL_PHASES:
            continue
        out.append({
            "ticket": meta.get("ticket", "?"),
            "title": meta.get("title", ""),
            "phase": meta.get("phase", "?"),
            "type": meta.get("type", ""),
            "updated_at": meta.get("updated_at", ""),
        })
    out.sort(key=lambda w: w["updated_at"], reverse=True)
    return json.dumps(out, ensure_ascii=False)


def fingerprint(repo):
    """Cheap fingerprint of the state on disk: if it does not change, we do not repaint."""
    marks = []
    for path in work_dirs(repo):
        for f in ("meta.json", "panel.md", "panel.json"):
            p = os.path.join(path, f)
            try:
                marks.append((p, os.stat(p).st_mtime_ns))
            except OSError:
                pass
    return tuple(marks)


# ─── render pieces ────────────────────────────────────────────────────────

def phase_track(meta, width, upto=None):
    """The flow's steps, fitted to the available width.

    Eight phase names do not fit in a narrow panel, so we degrade in three
    levels: full names → dots + current phase → counter.

    `upto` cuts the sequence at that phase (inclusive): with an MR train,
    from there on each MR's own route rules, not the work's.
    """
    sequence, done, current = phase_sequence(meta)

    if upto and upto in sequence:
        sequence = sequence[:sequence.index(upto) + 1]
        if current not in sequence:
            current = ""            # the current phase already lives in the train

    finished = current in TERMINAL_PHASES

    parts = []
    for p in sequence:
        if p == current:
            parts.append(f"{ORANGE}{BOLD}▶{p}{RESET}")
        elif p in done:
            parts.append(f"{GREEN}●{DIM}{p}{RESET}")
        else:
            parts.append(f"{DIM}○{p}{RESET}")

    plain = " ".join(("▶" if p == current else "●") + p for p in sequence)
    if vis(plain) <= width:
        return " ".join(parts)

    dots = "".join(
        f"{ORANGE}{BOLD}▶{RESET}" if p == current
        else (f"{GREEN}●{RESET}" if p in done else f"{DIM}○{RESET}")
        for p in sequence
    )
    label = "done" if finished else current
    if len(sequence) + 1 + vis(label) <= width:
        colour = GREEN if finished else ORANGE
        return f"{dots} {colour}{label}{RESET}"

    idx = len(sequence) if finished else (
        sequence.index(current) + 1 if current in sequence else len(done))
    return f"{DIM}{idx}/{len(sequence)}{RESET} {ORANGE}{cut(label, width - 6)}{RESET}"


def live_phase(meta, panel):
    """The phase running right now, to show it as text.

    meta.json runs one phase behind: flow only advances `phase` when the
    phase closes, so while validate runs the file still says build. If the
    summary carries its own `phase`, that is the right one for the text.
    """
    return (panel or {}).get("phase") or meta.get("phase", "?")


def is_terminal(meta):
    """Whether the work is closed. Always from meta: it is real state.

    The summary's phase says what is running, not whether the work ended,
    and it may carry values outside the cycle (watch writes "watching").
    """
    return meta.get("phase") in TERMINAL_PHASES


def phase_sequence(meta, panel=None):
    """This work's phases, without the optional ones that were not used."""
    done = set(meta.get("phases_done") or [])
    sequence = PHASES.get(meta.get("type"), PHASES["feat"])

    # the ▶ marks the running one; if the summary carries one outside the
    # cycle, it is ignored and meta's is used instead of marking none
    current = live_phase(meta, panel)
    if current not in sequence:
        current = meta.get("phase", "")

    if "brainstorm" in sequence and "brainstorm" not in done and current != "brainstorm":
        sequence = [p for p in sequence if p != "brainstorm"]
    return sequence, done, current


def phase_track_vertical(meta, width):
    """One phase per line, with its name.

    When the names do not fit horizontally, spending height is better than
    leaving the user guessing what each circle means.
    """
    sequence, done, current = phase_sequence(meta)
    out = []
    for phase in sequence:
        if phase == current:
            out.append(f"  {ORANGE}{BOLD}▶ {phase}{RESET}")
        elif phase in done:
            out.append(f"  {GREEN}●{RESET} {DIM}{phase}{RESET}")
        else:
            out.append(f"  {DIM}○ {phase}{RESET}")
    return out


def head_line(meta, width, panel=None):
    """The work's header: ticket, type, phase and when it was touched.

    The phase text comes from the summary if it has one (it is up to date);
    the colour always from meta, which is what knows whether the work is closed.
    """
    phase = live_phase(meta, panel)
    colour = GREEN if is_terminal(meta) else ORANGE
    ticket, typ, size = (meta.get("ticket", "?"), meta.get("type", ""),
                         meta.get("size", ""))
    head = (f"{BOLD}{YELLOW}{ticket}{RESET} {DIM}{typ}·{size}{RESET} "
            f"{colour}⏵ {phase}{RESET}")
    stamp = ago(meta.get("updated_at"))
    used = vis(f"{ticket} {typ}·{size} ⏵ {phase}")

    if used + 1 + vis(stamp) <= width:
        return [head + " " * (width - used - vis(stamp)) + f"{DIM}{stamp}{RESET}"]
    if used <= width:
        return [head, f"{DIM}{cut(stamp, width)}{RESET}"]
    out = [f"{BOLD}{YELLOW}{cut(ticket, width)}{RESET}"]
    tail = f"⏵ {phase}"
    if vis(tail) + 1 + vis(stamp) <= width:
        out.append(f"{colour}{tail}{RESET}"
                   + " " * (width - vis(tail) - vis(stamp))
                   + f"{DIM}{stamp}{RESET}")
    else:
        out.append(f"{colour}{cut(tail, width)}{RESET}")
    return out


# Phases each MR of the train goes through (the work's, from build
# onwards). A work with a train repeats this cycle once per MR.
MR_PHASES = ["build", "validate", "review", "ship"]


def mr_state(meta):
    """State of the MR train, or None if the work has none.

    An MR counts as closed if it is marked `merged` or if it went as far as
    `ship`: in practice flow leaves the state at `in_progress` until the
    merge is confirmed, and without this a half-done train shows as 0/N.
    """
    mrs = meta.get("mrs") or []
    if not mrs:
        return None

    def st(m):
        return m.get("status") or m.get("state") or ""

    def is_closed(m):
        return st(m) == "merged" or "ship" in (m.get("phases_done") or [])

    pending = [m for m in mrs if not is_closed(m)]
    current = next((m for m in pending if st(m) in ("in_progress", "opened")),
                   pending[0] if pending else None)
    return {
        "total": len(mrs),
        "closed": len(mrs) - len(pending),
        "current": current,
        "mrs": mrs,
        "is_closed": is_closed,
    }


def mr_lines(meta, width, vertical):
    """The train: how many are done, which one is under way and where it is."""
    train = mr_state(meta)
    if not train:
        return []

    dots = "".join(
        f"{GREEN}●{RESET}" if train["is_closed"](m)
        else (f"{ORANGE}{BOLD}▶{RESET}" if m is train["current"] else f"{DIM}○{RESET}")
        for m in train["mrs"]
    )
    head = f"{train['closed']}/{train['total']}"
    out = [f"  {DIM}train{RESET} {dots} {PURPLE}{head}{RESET}"]

    cur = train["current"]
    if not cur:
        return out

    n = cur.get("n", "?")
    for i, l in enumerate(wrap(cur.get("title", ""), width - 6, 2)):
        prefix = f"  {PURPLE}#{n}{RESET} " if i == 0 else "      "
        out.append(prefix + f"{FG}{l}{RESET}")

    done = set(cur.get("phases_done") or [])
    phase = meta.get("phase", "")
    marks = []
    for p in MR_PHASES:
        if p in done:
            marks.append((f"{GREEN}●{RESET}", p, DIM))
        elif p == phase:
            marks.append((f"{ORANGE}{BOLD}▶{RESET}", p, ORANGE + BOLD))
        else:
            marks.append((f"{DIM}○{RESET}", p, DIM))

    plain = " ".join("●" + p for p in MR_PHASES)
    if not vertical and vis(plain) <= width - 6:
        out.append("      " + " ".join(f"{m}{c}{p}{RESET}" for m, p, c in marks))
    else:
        out.extend(f"      {m} {c}{p}{RESET}" for m, p, c in marks)

    real, est = cur.get("lines_real"), cur.get("lines_est")
    if real and est:
        pct = round(100 * real / est)
        warn = " ⚠" if pct > 150 else ""
        out.append(f"      {DIM}{real}/{est} lines ({pct}%){warn}{RESET}")
    return out


def repos_line(meta, width):
    pending = [r for r in (meta.get("related_repos") or [])
               if r.get("status") != "done"]
    if not pending:
        return []
    names = ", ".join(r.get("repo", "?") for r in pending)
    prefix = vis("  ⚠ other repos: ")
    return [f"  {ORANGE}⚠{RESET} {DIM}other repos:{RESET} "
            f"{cut(names, width - prefix)}"]


# Styles the presentation JSON may ask for. Semantic names, not colours:
# that way the panel stays in charge of the palette and the width.
STYLES = {
    "normal": FG,
    "dim": DIM,
    "title": BOLD + YELLOW,
    "accent": PURPLE,
    "ok": GREEN,
    "warn": ORANGE,
    "error": BOLD + ORANGE,
}


URL_RE = re.compile(r"https?://[^\s<>\"]+")


def url_label(url):
    """Short label for a URL, keeping what identifies the resource."""
    for pattern, mark in ((r"/merge_requests/(\d+)", "!"),
                          (r"/pull/(\d+)", "#"),
                          (r"/issues/(\d+)", "#"),
                          (r"/-/pipelines/(\d+)", "pipeline ")):
        m = re.search(pattern, url)
        if m:
            return f"{mark}{m.group(1)} ↗"
    tail = url.rstrip("/").rsplit("/", 1)[-1]
    host = re.sub(r"^https?://(www\.)?", "", url).split("/")[0]
    return f"{host}/…/{tail[:12]} ↗" if tail else f"{host} ↗"


def linkify(text):
    """Replaces URLs with short labels and returns the map to link them.

    A GitLab URL is ~60 characters, which in a narrow panel wrap into three
    unreadable lines. We show `!9977 ↗` and keep the URL behind it, as a real
    terminal hyperlink (OSC 8): it looks short and opens with one click.
    """
    links = {}

    def swap(m):
        url = m.group(0)
        label = url_label(url)
        # if two URLs share a label, we disambiguate with an invisible suffix
        while label in links and links[label] != url:
            label += " "
        links[label] = url
        return label

    return URL_RE.sub(swap, text), links


def apply_links(line, links):
    """Wraps the labels already in place in clickable OSC 8 sequences."""
    for label, url in links.items():
        if label in line:
            link = f"\033]8;;{url}\033\\{label}\033]8;;\033\\"
            line = line.replace(label, link)
    return line


def read_panel_json(path):
    """The summary flow writes, if there is one.

    Contract: .claude/work/<work>/panel.json
      {
        "updated_at": "<ISO8601>",          optional but advisable
        "header": true,                     optional (true by default)
        "lines": [
          "plain text",                     → normal style
          {"text": "…", "style": "warn"},   → named style
          {"text": "…", "indent": 2}        → optional indent
        ]
      }
    """
    f = os.path.join(path, "panel.json")
    if not os.path.isfile(f):
        return None
    try:
        with open(f, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) and data.get("lines") else None


# Semantic marks: whoever writes says what each line is, the panel decides
# which symbol paints it and how the column aligns.
MARKS = {
    "done":    ("✓", GREEN),
    "current": ("▶", ORANGE + BOLD),
    "pending": ("·", DIM),
    "wait":    ("⏸", PURPLE),
    "block":   ("⚠", ORANGE),
    "info":    ("›", FG),
}


def panel_json_lines(data, width, max_lines):
    """Paints the JSON's lines, wrapping them to the panel's width.

    Lines with a `mark` form a column: symbol, aligned reference and, if it
    fits, its link pinned to the right. Those without one behave as always,
    so the old format still holds.
    """
    items = []
    for item in data.get("lines", []):
        if isinstance(item, str):
            items.append({"text": item})
        elif isinstance(item, dict):
            items.append(item)

    # Width of the reference column, computed per block (blocks are
    # separated by blank lines). That way the MR train aligns with the train,
    # and the labels below among themselves, without dragging each other.
    ref_widths, block = {}, []
    for idx, i in enumerate(items):
        if not str(i.get("text", "")).strip() and not i.get("link"):
            block = []
            continue
        block.append(idx)
        w = max((vis(str(items[j].get("ref", ""))) for j in block), default=0)
        for j in block:
            ref_widths[j] = w

    out = []
    for pos, item in enumerate(items):
        if len(out) >= max_lines:
            break

        text = str(item.get("text", ""))
        mark = item.get("mark")
        style = item.get("style")
        indent = int(item.get("indent", 0) or 0)
        link = item.get("link")

        if not text.strip() and not link:
            out.append("")
            continue

        if mark in MARKS:
            symbol, mark_colour = MARKS[mark]
            colour = STYLES.get(style, mark_colour)
            ref = str(item.get("ref", ""))
            ref_w = ref_widths.get(pos, 0)
            head = f" {symbol} " + (f"{ref:<{ref_w}}  " if ref_w else "")
            body_indent = vis(head)
            prefix_first = f"{DIM if mark == 'pending' else mark_colour}{head}{RESET}"
        else:
            colour = STYLES.get(style or "normal", FG)
            head, body_indent = " " * indent, indent
            prefix_first = head

        text, links = linkify(text)
        room = max(8, width - body_indent)
        wrapped = wrap(text, room, max_lines - len(out)) if text.strip() else [""]

        # the link is pinned to the right of the first line if there is room
        label = url_label(link) if link else None
        if label and vis(wrapped[0]) + 2 + vis(label) <= room:
            gap = " " * (room - vis(wrapped[0]) - vis(label))
            first = (f"{colour}{apply_links(wrapped[0], links)}{RESET}"
                     f"{gap}{DIM}\033]8;;{link}\033\\{label}\033]8;;\033\\{RESET}")
            label = None
        else:
            first = f"{colour}{apply_links(wrapped[0], links)}{RESET}"

        out.append(prefix_first + first)
        for l in wrapped[1:]:
            out.append(" " * body_indent + f"{colour}{apply_links(l, links)}{RESET}")
        if label:                       # it did not fit beside it: hang it below
            out.append(" " * body_indent
                       + f"{DIM}\033]8;;{link}\033\\{label}\033]8;;\033\\{RESET}")
    return out[:max_lines]


def staleness(data, meta):
    """Warning if the summary has gone long without a refresh.

    It is the model's safeguard: flow writes *before* each long stretch, so
    if it dies halfway the file still says what it was doing, and it is the
    age that gives away that it is no longer true.

    Two nuances:
    - In a closed work (done/abandoned) an old summary is correct, not
      suspicious: it will never move again.
    - The summary itself can raise the threshold with `stale_after_minutes`,
      for stretches known to take long (CI polling, long suites).
    """
    if (meta or {}).get("phase") in TERMINAL_PHASES:
        return None
    stamp = data.get("updated_at")
    if not stamp:
        return None
    try:
        from datetime import datetime, timezone
        then = datetime.fromisoformat(stamp)
        if then.tzinfo is None:
            then = then.replace(tzinfo=timezone.utc)
        mins = (datetime.now(timezone.utc) - then).total_seconds() / 60
    except ValueError:
        return None
    limit = data.get("stale_after_minutes") or 30
    try:
        limit = float(limit)
    except (TypeError, ValueError):
        limit = 30
    return ago(stamp) if mins > limit else None


def notes_lines(path, width, limit):
    """Free space: whatever the agent wants to say goes here."""
    note = os.path.join(path, "panel.md")
    if not os.path.isfile(note):
        return []
    try:
        with open(note, encoding="utf-8") as fh:
            body = [l.rstrip() for l in fh if l.strip()][-limit:]
    except OSError:
        return []
    if not body:
        return []
    out = [f"  {DIM}┄┄┄{RESET}"]
    out.extend(f"  {FG}{cut(l, width - 2)}{RESET}" for l in body)
    return out


def work_block(path, meta, width, notes=6, title_lines=2, phases_vertical=False,
               body_lines=40):
    lines = [""]

    # If flow left a summary, it rules: it knows the work's real meaning
    # and there is no need to deduce it from outside.
    data = read_panel_json(path)
    if data:
        if data.get("header", True):
            lines.extend(head_line(meta, width, data))
        old = staleness(data, meta)
        if old:
            lines.append(f"{ORANGE}⚠ summary not refreshed · {old}{RESET}")
        lines.extend(panel_json_lines(data, width, body_lines))
        return lines

    lines.extend(head_line(meta, width))
    for l in wrap(meta.get("title", ""), width, title_lines):
        lines.append(f"{FG}{l}{RESET}")
    train = mr_state(meta)
    if train:
        # With a train, the work's phases stop at the preparation: from
        # build onwards each MR repeats the route, and mixing them paints
        # green phases this MR has not seen yet.
        lines.append("  " + phase_track(meta, width - 2, upto="plan"))
    elif phases_vertical:
        lines.extend(phase_track_vertical(meta, width))
    else:
        lines.append("  " + phase_track(meta, width - 2))
    lines.extend(mr_lines(meta, width, phases_vertical))
    lines.extend(repos_line(meta, width))
    lines.extend(notes_lines(path, width, notes))
    return lines


def compact_line(meta, width, panel=None):
    """A single line: for the works that do not fit in detail."""
    phase = live_phase(meta, panel)
    colour = GREEN if is_terminal(meta) else ORANGE
    stamp = ago(meta.get("updated_at"))
    ticket, typ = meta.get("ticket", "?"), meta.get("type", "")
    left = f"{ticket} {typ} ⏵ {phase}"
    if vis(left) + 1 + vis(stamp) <= width:
        gap = " " * (width - vis(left) - vis(stamp))
        return (f"{YELLOW}{ticket}{RESET} {DIM}{typ}{RESET} "
                f"{colour}⏵ {phase}{RESET}{gap}{DIM}{stamp}{RESET}")
    return f"{YELLOW}{cut(left, width)}{RESET}"


def assemble(head_lines, blocks, height):
    """Fits the works into the available height.

    The most recent ones go in full detail; the rest shrink to one line.
    That way what matters stays on top and nothing spills over the top
    edge, which is what happened when the terminal scrolled by itself.
    """
    budget = height - len(head_lines)
    n = len(blocks)

    def cost(detailed):
        c = sum(len(b[0]) if i < detailed else 1 for i, b in enumerate(blocks))
        return c + (1 if detailed < n else 0)

    detailed = next((k for k in range(n, -1, -1) if cost(k) <= budget), 0)

    out = list(head_lines)
    for i, (full, compact) in enumerate(blocks):
        if i < detailed:
            out.extend(full)
        else:
            if i == detailed:
                out.append("")
            if len(out) >= height:
                out.append(f"{DIM}+{n - i} more{RESET}")
                break
            out.append(compact)
    return out[:height]


# ─── the two modes ────────────────────────────────────────────────────────

def render_list(repo, width, height):
    """Every open work in the repo."""
    name = os.path.basename(os.path.abspath(repo))
    head_lines = [
        f"{BOLD}{BLUE}FLOW{RESET} {DIM}·{RESET} {FG}{name}{RESET}",
        f"{DIM}{'─' * width}{RESET}",
    ]

    dirs = work_dirs(repo)
    if not dirs:
        return head_lines + [
            "",
            f"{DIM}No active works in .claude/work/{RESET}",
            f"{DIM}Start one with /flow:feat:start{RESET}",
        ]

    works = []
    for path in dirs:
        meta = read_meta(path)
        works.append((meta.get("updated_at", "") if meta else "", path, meta))
    works.sort(key=lambda w: w[0], reverse=True)

    blocks = []
    for _, path, meta in works:
        if meta is None:
            bad = f"{ORANGE}⚠ {cut(os.path.basename(path), width - 2)}{RESET}"
            blocks.append((["", bad, f"{DIM}meta.json unreadable{RESET}"], bad))
        else:
            panel = read_panel_json(path)
            blocks.append((work_block(path, meta, width),
                           compact_line(meta, width, panel)))
    return assemble(head_lines, blocks, height)


def render_focus(repo, width, height, cwd, wanted=None):
    """A single work, with all the detail that fits."""
    branch = current_branch(cwd)
    path, meta = pick_work(repo, branch, wanted)

    if meta is None:
        name = os.path.basename(os.path.abspath(repo))
        out = [f"{BOLD}{BLUE}FLOW{RESET} {DIM}·{RESET} {FG}{name}{RESET}",
               f"{DIM}{'─' * width}{RESET}", ""]
        if wanted:
            out.append(f"{DIM}There is no work{RESET}")
            out.append(f"{FG}{cut(wanted, width)}{RESET}")
        else:
            out.append(f"{DIM}No open works{RESET}")
            out.append(f"{DIM}in .claude/work/{RESET}")
        return out[:height]

    # no header of its own: the block already carries the ticket, and in a
    # small split every line counts. In focus there is room: the whole title,
    # the phases by name if they do not fit across, and the notes filling the rest.
    sequence, _, _ = phase_sequence(meta)
    horizontal = vis(" ".join("●" + p for p in sequence)) <= width - 2
    vertical = not horizontal and height >= len(sequence) + 6

    def build(notes):
        return work_block(path, meta, width, notes=notes, title_lines=6,
                          phases_vertical=vertical, body_lines=height - 2)

    room = max(1, height - (len(build(0)) - 1))
    return build(room)[1:][:height]


def main():
    args = sys.argv[1:]
    focus = "--focus" in args
    wanted = None
    if "--work" in args:
        i = args.index("--work")
        if i + 1 < len(args):
            wanted, focus = args[i + 1], True
        args = args[:i] + args[i + 2:]

    paths = [a for a in args if not a.startswith("--")]
    cwd = os.path.abspath(paths[0]) if paths else os.getcwd()
    repo = find_repo(cwd)

    # query mode: the WezTerm picker asks which works there are
    if "--json" in sys.argv[1:]:
        print(list_json(repo))
        return

    last = None
    sys.stdout.write("\033[?25l")          # hide the cursor
    try:
        while True:
            size = shutil.get_terminal_size()
            state = (fingerprint(repo), size.columns, size.lines,
                     current_branch(cwd) if focus and not wanted else "")
            if state != last:
                # one cell of margin per side: it keeps the terminal from
                # breaking lines or scrolling, which pushed the content upwards
                width = max(20, size.columns - 1)
                height = max(6, size.lines - 1)
                lines = (render_focus(repo, width, height, cwd, wanted) if focus
                         else render_list(repo, width, height))
                sys.stdout.write(CLEAR + "\n".join(lines))
                sys.stdout.flush()
                last = state
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h")      # restore the cursor
        sys.stdout.flush()


if __name__ == "__main__":
    main()
